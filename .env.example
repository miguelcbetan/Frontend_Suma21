# Copia este archivo como `.env.local` para cambiar valores en tu máquina.
# Todas las variables son públicas (quedan dentro del bundle): nunca pongas aquí
# claves privadas ni secretos de Wompi. La llave pública y la firma de
# integridad de Wompi las entrega el backend en cada checkout.

# Origen del backend de datos, sin barra final ni prefijo. Por defecto, Render.
VITE_API_URL=https://suma21-backend.onrender.com

# Prefijo de versión de la API REST. Por defecto /api/v1.
VITE_API_PREFIX=/api/v1

# Servicio de autenticación (/auth/*), sin barra final.
# Nota: hoy solo acepta el origen https://suma21-frontend.onrender.com;
# desde http://localhost:5173 responde 403 «Origen no autorizado».
VITE_AUTH_URL=https://proyecto-integrador-backend-g2.onrender.com
