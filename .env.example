# Backend de datos (/api/*), sin barra final. Si se omite se usa el despliegue en Render.
VITE_API_URL=https://suma21-backend.onrender.com
# Backend local:
# VITE_API_URL=http://127.0.0.1:3000

# Servicio de autenticación (/auth/*), sin barra final.
VITE_AUTH_URL=https://proyecto-integrador-backend-g2.onrender.com

# IDs del método de pago y de la cuenta con los que se registran los pagos de Wompi.
# Deben existir en el backend de datos (GET /api/payment-methods y GET /api/accounts).
VITE_WOMPI_PAYMENT_METHOD_ID=1
VITE_WOMPI_ACCOUNT_ID=2
